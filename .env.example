# Pflicht
LOKYY_PUBLIC_URL=https://mail.kunde.de
# Erzeugen: openssl rand -base64 32   (oder: lokyymail generate-key). Gut aufbewahren! Ohne ihn sind alle Zugangsdaten verloren.
LOKYY_MASTER_KEY=
POSTGRES_PASSWORD=

# Eigene Firmen-Domains, kommagetrennt. Empfänger außerhalb gelten als extern (hohes Risiko).
LOKYY_ORG_DOMAINS=kunde.de

# Google Workspace (eigenes Google-Cloud-Projekt des Kunden, Typ "Intern"), siehe docs/google-workspace.md
LOKYY_GOOGLE_CLIENT_ID=
LOKYY_GOOGLE_CLIENT_SECRET=

# Optional
LOKYY_MCP_EXTRA_HOSTS=lokyymail:8080
LOKYY_PROPOSAL_TTL_MINUTES=15
LOKYY_AUDIT_RETENTION_DAYS=365
LOKYY_TIMEZONE=Europe/Berlin
# Nur zum Ausprobieren: Demo-Postfach mit eingebauter Angriffs-Mail
LOKYY_DEMO_MODE=0

# Telegram: eigener Bot pro Kunde (BotFather), siehe docs/telegram.md. NIE den Bot von Hermes nehmen!
LOKYY_TELEGRAM_BOT_TOKEN=
# Freigaben direkt in Hermes erlauben? Nur 1, wenn Hermes getrennt läuft, siehe docs/sicherheit.md
LOKYY_HERMES_APPROVALS=0
# Aufräumen ohne Freigabe: Höchstzahl Mails pro Stunde und Postfach, und wie lange die Rückgängig-Liste bleibt
LOKYY_AUTO_CLEANUP_PER_HOUR=60
LOKYY_UNDO_DAYS=7
# Tagesbericht per Telegram ab dieser Uhrzeit (lokale Zeit), -1 = aus
LOKYY_DAILY_REPORT_HOUR=18
